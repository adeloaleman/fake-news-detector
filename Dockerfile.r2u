## Fast build (Ubuntu+r2u): install CRAN packages as Ubuntu binaries (no source compile).
##
## Build:
##   docker build -f Dockerfile.r2u -t fake-news-detector:r2u .
## Run:
##   docker run --rm -p 3838:3838 fake-news-detector:r2u

FROM rocker/r2u:noble AS deps

ENV DEBIAN_FRONTEND=noninteractive

# System libs for packages that link to external libraries (pdftools, xml2, curl, magick/imager, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff-dev \
    libjpeg-dev \
    libmagick++-dev \
    libfftw3-dev \
    libpoppler-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install as many CRAN packages as possible via apt binaries (r2u).
# If any of these packages don't exist as r-cran-* in r2u yet, the build will fail;
# in that case we can move that package to the fallback install.packages() step below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-cran-shiny \
    r-cran-devtools \
    r-cran-readtext \
    r-cran-readxl \
    r-cran-readr \
    r-cran-readods \
    r-cran-pdftools \
    r-cran-streamr \
    r-cran-tm \
    r-cran-snowballc \
    r-cran-imager \
    r-cran-xgboost \
    r-cran-mlapi \
    r-cran-text2vec \
    r-cran-randomforest \
    r-cran-tree \
    r-cran-prodlim \
    r-cran-ipred \
    r-cran-catools \
    r-cran-glmnet \
    r-cran-e1071 \
    r-cran-tau \
    && rm -rf /var/lib/apt/lists/*

# Fallback for anything missing from apt (kept minimal; should usually be empty).
RUN R -e "options(repos='https://cloud.r-project.org/'); install.packages(c('remotes'))"

# --- App stage ---
FROM deps
WORKDIR /app
COPY . /app

# RTextTools dependencies (not all in r2u; install from CRAN before local packages)
RUN R -e "options(repos='https://cloud.r-project.org/'); install.packages(c('SparseM', 'maxent'))"

# Install local packages (required; build must run from repo root that contains R-packages.n0b4).
# If you still get "no package called FakeNewsDetector", sync this Dockerfile to the server and rebuild with: docker build --no-cache -f Dockerfile.r2u -t fake-news-detector:r2u .
RUN R CMD INSTALL /app/R-packages.n0b4/RTextTools-modificado/RTextTools && \
    R CMD INSTALL /app/R-packages.n0b4/FakeNewsDetector && \
    rm -rf /app/R-packages.n0b4
# Verify packages load (build fails here if install was skipped or broken)
RUN R -e "library(RTextTools); library(FakeNewsDetector); cat('RTextTools + FakeNewsDetector OK\n')"

RUN chmod -R a+rX /app && chmod -R a+w /app
EXPOSE 3838
CMD ["R", "-e", "shiny::runApp('/app', host='0.0.0.0', port=3838)"]

