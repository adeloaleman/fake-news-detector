server {
    listen 80;
    listen [::]:80;
    server_name fake-news-detector.sinfrontera.net;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fake-news-detector.sinfrontera.net;

    # SSL certificates (Let's Encrypt; certbot will set these if you use --nginx)
    ssl_certificate     /etc/letsencrypt/live/fake-news-detector.sinfrontera.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fake-news-detector.sinfrontera.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Proxy to Shiny app
    location / {
        proxy_pass http://127.0.0.1:3838;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Shiny WebSocket and long-polling
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 20d;
        proxy_buffering off;
    }
}
