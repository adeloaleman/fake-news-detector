    antiword \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Freeze CRAN snapshot to match R 3.4.4 era
RUN echo "options(repos = c(CRAN='https://mran.microsoft.com/snapshot/2018-03-15'))" >> /usr/local/lib/R/etc/Rprofile.site

