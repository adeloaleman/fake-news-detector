FROM rocker/r-ver:3.4.4

ENV DEBIAN_FRONTEND=noninteractive

# System libraries required by R packages
RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    libcurl4-openssl-dev \
    libssl-dev \
