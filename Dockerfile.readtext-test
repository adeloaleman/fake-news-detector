# Minimal image to TEST readtext install only. Build once (~2 min), then run the
# R script with a volume mount—no rebuild when you change the script.
# Same R version as main app.
FROM rocker/r-ver:3.4.4

# Allow apt on EOL Debian (Stretch) if the base image uses it
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|http://security.debian.org|http://archive.debian.org|g' /etc/apt/sources.list 2>/dev/null || true && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-valid-until 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Run: docker run --rm -v $(pwd):/app readtext-test R -f scripts/install-readtext-test.R
# Edit scripts/install-readtext-test.R on the host and re-run the same command (no rebuild).
